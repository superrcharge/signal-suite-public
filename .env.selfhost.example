# Copy to .env.selfhost (gitignored) and set the password. Everything else is optional.

# Password for the PostgreSQL container. Pick anything; it never leaves the compose network.
POSTGRES_PASSWORD=change-me

# Interface the app is published on. 127.0.0.1 = this machine only (default).
# 0.0.0.0 = every interface, which exposes an app with no sign-in to your network.
# Read "Exposing it safely" in docs/self-hosting.md first.
SELFHOST_BIND=127.0.0.1

# Host port. Change if 3001 is taken.
SELFHOST_PORT=3001

# Comma-separated proxy addresses whose X-Forwarded-For the app should trust.
# Leave empty unless a reverse proxy on a non-private address sits in front.
TRUSTED_PROXIES=
