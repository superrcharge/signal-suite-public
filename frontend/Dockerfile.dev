# Development Dockerfile for Vite with hot reloading
# Used by compose.dev.yaml as the frontend-dev container; the backend on :3001 proxies it

FROM node:26-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Source code will be mounted via volume
EXPOSE 5173

# Start Vite dev server with host binding for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
